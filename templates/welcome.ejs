<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Welcome to <%= appName || "TechyJaunt" %></title>
  </head>
  <body
    style="
      margin: 0;
      padding: 24px;
      background: #f4f4f5;
      font-family: Arial, sans-serif;
      color: #18181b;
    "
  >
    <main
      style="
        max-width: 600px;
        margin: 0 auto;
        padding: 32px;
        background: #fff;
        border-radius: 8px;
      "
    >
      <p
        style="
          margin: 0 0 24px;
          color: #2563eb;
          font-size: 14px;
          font-weight: bold;
        "
      >
        <%= appName || "TechyJaunt" %>
      </p>
      <h1 style="margin: 0 0 16px; font-size: 26px; line-height: 1.3">
        Welcome, <%= userName %>!
      </h1>
      <p style="font-size: 16px; line-height: 1.6">
        We're excited to have you on board. Your account is ready to use.
      </p>
      <p
        style="
          margin-top: 32px;
          color: #52525b;
          font-size: 14px;
          line-height: 1.6;
        "
      >
        Thanks for joining us,<br /><%= appName || "TechyJaunt" %> Team
      </p>
    </main>
  </body>
</html>
