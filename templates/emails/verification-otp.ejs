<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= subject %></title>
  </head>
  <body style="margin:0;padding:24px;background:#f4f4f5;font-family:Arial,sans-serif;color:#18181b;">
    <main style="max-width:600px;margin:0 auto;padding:32px;background:#fff;border-radius:8px;">
      <p style="margin:0 0 24px;color:#2563eb;font-size:14px;font-weight:bold;"><%= appName %></p>
      <h1 style="margin:0 0 16px;font-size:24px;line-height:1.3;">Verify your email address</h1>
      <p style="font-size:16px;line-height:1.6;">Hello<% if (firstName) { %>, <%= firstName %><% } %>,</p>
      <p style="font-size:16px;line-height:1.6;">Enter this verification code to continue:</p>
      <p style="margin:24px 0;padding:16px;background:#f4f4f5;border-radius:4px;text-align:center;font-size:32px;font-weight:bold;letter-spacing:6px;"><%= otp %></p>
      <p style="font-size:14px;line-height:1.6;color:#52525b;">This code expires in 10 minutes. If you didn't request it, you can ignore this email.</p>
      <hr style="margin:32px 0;border:0;border-top:1px solid #e4e4e7;" />
      <p style="margin:0;color:#71717a;font-size:13px;">This is an automated message from <%= appName %>.</p>
    </main>
  </body>
</html>